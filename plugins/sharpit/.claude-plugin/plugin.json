{
  "name": "sharpit",
  "version": "0.7.0",
  "displayName": "sharpit",
  "description": "Ask a running FastAPI app about itself: routes, configuration, SQL, exceptions, health and advisors, over sharpit's read-only local MCP server.",
  "author": {
    "name": "Flavio Oliva",
    "url": "https://github.com/ffroliva"
  },
  "homepage": "https://ffroliva.github.io/sharpit/mcp/",
  "repository": "https://github.com/ffroliva/sharpit",
  "license": "Apache-2.0",
  "keywords": [
    "fastapi",
    "starlette",
    "python",
    "mcp",
    "observability",
    "diagnostics"
  ],
  "mcpServers": {
    "sharpit": {
      "type": "http",
      "url": "${SHARPIT_MCP_URL:-http://127.0.0.1:8000/sharpit/api/mcp}"
    }
  }
}
