diff --git a/tests/engine/collectors/database_advisor/test_wiring_e2e.py b/tests/engine/collectors/database_advisor/test_wiring_e2e.py
new file mode 100644
index 0000000..80b1064
--- /dev/null
+++ b/tests/engine/collectors/database_advisor/test_wiring_e2e.py
@@ -0,0 +1,40 @@
+"""The scan feeds the ORM, runtime and vendor rules (coordinator wiring for A-dbadv-2)."""
+
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+from fastapi.testclient import TestClient
+from tests.engine.postgresql.fakes import FakeRegistry
+
+from fastapi import FastAPI
+from sharpit import install
+
+pytestmark = pytest.mark.needs_sqlalchemy
+sa = pytest.importorskip("sqlalchemy")
+orm = pytest.importorskip("sqlalchemy.orm")
+StaticPool = pytest.importorskip("sqlalchemy.pool").StaticPool
+
+
+def test_scan_runs_orm_rules_from_install_models() -> None:
+    engine = sa.create_engine("sqlite://", poolclass=StaticPool, connect_args={"check_same_thread": False})
+    with engine.begin() as conn:
+        conn.exec_driver_sql("CREATE TABLE users (id INTEGER PRIMARY KEY)")
+    reg = orm.registry()
+    table = sa.Table(
+        "users", reg.metadata, sa.Column("id", sa.Integer, primary_key=True), sa.Column("email", sa.String(50))
+    )
+    user = type("User", (), {})  # the registry holds mapped classes weakly
+    reg.map_imperatively(user, table)
+    reg.configure()
+    app = FastAPI()
+    handle = install(app, enabled="ON", show_banner=False, config_scan=False, models=(reg,))
+    handle.context.capture.engine_registry = FakeRegistry(("db", engine))
+    client = TestClient(app, base_url="http://localhost", client=("127.0.0.1", 50000))
+
+    response = client.post("/sharpit/api/database-advisor/scan")
+    report: dict[str, Any] = response.json()
+
+    assert user.__name__ == "User"
+    assert "DB-HIB-006" in [r["id"] for r in report["results"]]
